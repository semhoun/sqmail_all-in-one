#!/bin/ksh
QMAIL="/var/qmail"
#
alias -x SPAMMER='/usr/local/bin/spamc'
alias -x 822FIELD='/usr/local/bin/822field'
#
# SQMail exports a space-delimited recipient list with a trailing separator.
# One queued message cannot use several personal profiles; retain global policy
# for multi-recipient messages instead of selecting an arbitrary recipient.
RECIPIENT=${RCPTTO% }
case "$RECIPIENT" in
        ''|*[[:space:]]*) RECIPIENT='$GLOBAL' ;;
esac
VERBOSE=0

#
## No code change necessary from here
#
typeset SPAM
integer SPAMC=0
integer RC=0
integer SPAMTHRESHOLD=-1
integer SPAMTH
typeset SPAMDOMAINS

. ${QMAIL}/control/mysql.conf

ID="${RANDOM}$$"
MESSAGE="${QMAIL}/tmp/msg.${ID}"
export DTLINE="spam-queue"

#
[[ ! -d ${QMAIL}/tmp ]] && exit 53
cat > ${MESSAGE} || exit 53

#
## Check Spamlevel for each domain
#
DOMAIN=${RECIPIENT##*@}
RECIPIENT_HEX=$(printf '%s' "$RECIPIENT" | od -An -v -tx1 | tr -d ' \n')
DOMAIN_HEX=$(printf '%%%s' "$DOMAIN" | od -An -v -tx1 | tr -d ' \n')
if ! SPAMTHRESHOLD=$(printf '%s\n' "SELECT CAST(value AS SIGNED) FROM spam_prefs WHERE (username = CONVERT(0x${RECIPIENT_HEX} USING utf8mb4) OR username = '\$GLOBAL' OR username = CONVERT(0x${DOMAIN_HEX} USING utf8mb4)) AND preference = 'refuse_threshold' ORDER BY CASE username WHEN CONVERT(0x${RECIPIENT_HEX} USING utf8mb4) THEN 0 WHEN CONVERT(0x${DOMAIN_HEX} USING utf8mb4) THEN 1 ELSE 2 END LIMIT 1;" | mysql -N -B -u "${MYSQL_USER}" -p"${MYSQL_PASS}" -h "${MYSQL_HOST}" "${MYSQL_DB}"); then
        rm -f "$MESSAGE"
        exit 53
fi

[[ ${VERBOSE} -gt 0 ]] && print -u2 "User ${RCPTTO} / Domain ${DOMAIN} -- Threshold: {$SPAMTHRESHOLD}"

if [[ ${SPAMTHRESHOLD} -ge 0 ]]; then
#
## Spam recognition -- the following codes is only useful for SpamAssassins spamc version 3.x
#
        SPAMMER -x -u "$RECIPIENT" < "$MESSAGE" > "${MESSAGE}_$$" && mv "${MESSAGE}_$$" "$MESSAGE" || {
                rm -f "$MESSAGE" "${MESSAGE}_$$"
                exit 53
        }
        SPAM=$(822FIELD "X-Spam-Level" < ${MESSAGE} | head -1)
        SPAM=${SPAM# }

        if [[ "x${SPAM}" != "x" ]]; then
                [[ $(echo "${SPAM}" | grep -c "\*") -gt 0 ]] && SPAMC=$(echo "${SPAM}" | wc -c)
        else
                SPAMC=$(echo "${SPAM}" | awk -F"/" '{print $1}' | awk -F"." '{print $1}')
        fi
        [[ ${VERBOSE} -gt 0 ]] && print -u2 "Spam: $SPAM - Spamc: $SPAMC"
#
## Spam rejection
#
        if [[ ${SPAMTHRESHOLD} -gt 0 && ${SPAMC} -gt 0 && ${SPAMC} -gt ${SPAMTHRESHOLD} ]]; then
            export SPAMSCORE="${SPAMC}"
            RC=33
        fi
fi

if [[ ${RC} -eq 0 ]]; then
        ${QMAIL}/bin/qmail-queue < ${MESSAGE}
        RC=$?
fi

rm ${MESSAGE}
exit ${RC}
